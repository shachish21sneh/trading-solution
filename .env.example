APP_NAME="OptionChain Intelligence Terminal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Configuration (MySQL Production Default)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=option_chain_intelligence
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache (Redis High-Performance Storage)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WebSocket Broadcast Driver (Laravel Reverb / Pusher Compatible)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=option_terminal
REVERB_APP_KEY=option_terminal_key
REVERB_APP_SECRET=option_terminal_secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME="http"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Market Data Feed Provider Configuration
# Supported drivers: simulation | zerodha | upstox | angelone | fyers
MARKET_DATA_PROVIDER=simulation
MARKET_DATA_STREAM_INTERVAL=5

# Zerodha Kite Connect Credentials
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Upstox API v2 Credentials
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# Angel One SmartAPI Credentials
SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PASSWORD=
SMARTAPI_TOTP=

# FYERS API v3 Credentials
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=
